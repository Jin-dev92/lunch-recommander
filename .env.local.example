NEXT_PUBLIC_SUPABASE_URL=<로컬 또는 배포 Supabase 프로젝트 URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<브라우저용 Supabase anon 키>
NEXT_PUBLIC_KAKAO_MAP_KEY=<사이트 도메인을 등록한 카카오 JavaScript 키 — 국내 지도>
NEXT_PUBLIC_GOOGLE_MAPS_KEY=<HTTP referrer 제한을 적용한 Google Maps 브라우저 키 — 해외 지도>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<Cloudflare Turnstile 공개 site key>
